LOG_LEVEL=debug
LOG_FORMAT=text
HTTP_ADDR=:8080
JWT_PRIVATE_KEY_FILE=secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=secrets/jwt_public.pem
JWT_SERVICE_SECRET=change-me
JWT_TTL=8h
USERS_FILE=configs/users.json
UPSTREAM_PROCESSOR=http://localhost:8081
UPSTREAM_LICENSE=http://localhost:8083
UPSTREAM_CHAT=http://localhost:8084
LIMIT_MAX_UPLOAD_MB=50
LIMIT_LOGIN_PER_MINUTE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
