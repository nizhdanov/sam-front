LOG_LEVEL=debug
LOG_FORMAT=text
HTTP_ADDR=:8081
JWT_PUBLIC_KEY_FILE=secrets/jwt_public.pem
JWT_SERVICE_SECRET=change-me
POSTGRES_DSN=postgres://inventory:inventory@localhost:5432/inventory_db?sslmode=disable
NATS_URL=nats://localhost:4222
IMPORT_STORAGE_DIR=./data/imports
IMPORT_MAX_FILE_SIZE_MB=50
IMPORT_MAX_ROWS=500000
IMPORT_MAX_CONCURRENT_UPLOADS=2
IMPORT_PARSE_CONCURRENCY=1
IMPORT_RETENTION_DAYS=7
