LOG_LEVEL=debug
LOG_FORMAT=text
HTTP_ADDR=:8083
GRPC_ADDR=:9093
JWT_PUBLIC_KEY_FILE=secrets/jwt_public.pem
JWT_SERVICE_SECRET=change-me
POSTGRES_DSN=postgres://license:license@localhost:5432/license_db?sslmode=disable
POSTGRES_MAX_CONNS=5
LLM_GRPC_ADDR=localhost:9095
LLM_TIMEOUT=120s
MATCH_HIGH_THRESHOLD=0.95
MATCH_CANDIDATE_THRESHOLD=0.65
MATCH_MIN_GAP=0.1
MATCH_MAX_CANDIDATES=5
MATCH_LLM_ACCEPT_CONFIDENCE=0.85
COMPLIANCE_CHECK_INTERVAL=1h
